# Verioax configuration.
# Copy this file to .env and fill in what you need. Every value is optional - with nothing set, Verioax runs fully
# locally with its own rules and the built-in list of known scam domains.
# .env is listed in .gitignore: never commit real keys.

# ---------------------------------------------------------------- storage
# Where scan history, the lookup cache, preferences and your own indicator list are kept.
TRUSTGUARD_DATA_DIR=data/runtime

# ---------------------------------------------------------------- web app <-> API
# Leave empty to let the web app run the engine in-process (simplest).
# Set it to use a separately running API instead, e.g. http://localhost:8000
TRUSTGUARD_API_URL=
# If set, every /v1 API call needs the header "Authorization: Bearer <token>". Set this whenever the API is reachable
# from anywhere other than your own machine. The web app sends it automatically when TRUSTGUARD_API_URL is set.
TRUSTGUARD_API_TOKEN=

# ---------------------------------------------------------------- live link checks (guarded fetcher)
TRUSTGUARD_FETCH_TIMEOUT_S=8
TRUSTGUARD_MAX_REDIRECTS=5
TRUSTGUARD_MAX_PAGE_BYTES=1500000

# ---------------------------------------------------------------- threat intelligence (all optional)
# Google Safe Browsing Lookup API v4 - https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal API v3 (free community key, ~4 lookups/minute) - https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# URLhaus by abuse.ch (free Auth-Key) - https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
# PhishTank (application key + the username it is registered to)
PHISHTANK_APP_KEY=
PHISHTANK_USERNAME=
# OpenPhish community feed (download is switched on in Settings > Network; no key needed)
OPENPHISH_FEED_URL=https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt

# ---------------------------------------------------------------- claim verification (optional)
# Google Fact Check Tools API - https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=

# ---------------------------------------------------------------- optional local AI explanation (Ollama)
# Only used when "AI explanation" is switched on in Settings. The model receives redacted text and the findings list,
# never raw personal data or page content, and it cannot change the verdict.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Verioax configuration.
# Copy this file to .env and fill in what you need. Every value is optional - with nothing set, Verioax runs fully
# locally with its own rules and the built-in list of known scam domains.
# .env is listed in .gitignore: never commit real keys.

# ---------------------------------------------------------------- moderators
# The 6-digit PIN that moderators enter when they create their account and every time they sign in.
# Leave it empty to switch moderator access off. Never write the PIN into the code: the repository is public.
VERIOAX_MODERATOR_PIN=

# ---------------------------------------------------------------- storage
# Where scan history, accounts and the activity log, the lookup cache, preferences and your own indicator list are kept.
TRUSTGUARD_DATA_DIR=data/runtime

# ---------------------------------------------------------------- web app <-> API
# Leave empty to let the web app run the engine in-process (simplest).
# Set it to use a separately running API instead, e.g. http://localhost:8000
TRUSTGUARD_API_URL=
# Every /v1 API call from another machine needs "Authorization: Bearer <token>". If you leave this empty, the API
# generates a random token on first start and saves it as api.token in the data folder (the web app reads it from
# there when both share the folder); only direct calls from the same machine (127.0.0.1, no proxy headers) are then
# accepted without it. Set your own value (at least 32 characters) for any deployment that is reachable over a network:
# then every call, local ones included, needs it.
TRUSTGUARD_API_TOKEN=

# ---------------------------------------------------------------- several workers / servers (all optional)
# Shared PostgreSQL database for accounts, activity, feedback, scan history and preferences. Without it every process
# uses SQLite files in TRUSTGUARD_DATA_DIR, which is right for one machine. Needs: pip install "psycopg[binary]" psycopg-pool
#   VERIOAX_DATABASE_URL=postgresql://verioax:CHANGE-ME@localhost:5432/verioax
VERIOAX_DATABASE_URL=
VERIOAX_DATABASE_POOL_SIZE=10
# Shared rate limits across API workers (Redis). Without it each worker counts on its own. Needs: pip install redis
#   VERIOAX_REDIS_URL=redis://localhost:6379/0
VERIOAX_REDIS_URL=
# Keeps scan-history fingerprints stable across machines (any long random string). Optional.
VERIOAX_SECRET_KEY=

# ---------------------------------------------------------------- limits
# Per client, "<requests>/<seconds>". Scans: message and link scans; files: uploads; api: every /v1 call; ui_scan: per
# signed-in account in the web app.
VERIOAX_RATE_LIMIT_SCAN=30/60
VERIOAX_RATE_LIMIT_FILE=10/60
VERIOAX_RATE_LIMIT_API=300/60
VERIOAX_RATE_LIMIT_UI_SCAN=20/60
# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated addresses or networks), e.g. 10.0.0.0/8.
# Leave empty when clients connect directly: then nobody can fake their address with that header.
VERIOAX_TRUSTED_PROXIES=
# Scans running at once in one process, and how long a request waits for a free slot before getting HTTP 503.
VERIOAX_MAX_CONCURRENT_SCANS=8
VERIOAX_MAX_CONCURRENT_FILE_SCANS=2
VERIOAX_SCAN_QUEUE_TIMEOUT_S=20

# ---------------------------------------------------------------- live link checks (guarded fetcher)
TRUSTGUARD_FETCH_TIMEOUT_S=8
TRUSTGUARD_MAX_REDIRECTS=5
TRUSTGUARD_MAX_PAGE_BYTES=1500000

# ---------------------------------------------------------------- threat intelligence (all optional)
# Google Safe Browsing Lookup API v4 - https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal API v3 (free community key, ~4 lookups/minute) - https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# URLhaus by abuse.ch (free Auth-Key) - https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
# PhishTank (application key + the username it is registered to)
PHISHTANK_APP_KEY=
PHISHTANK_USERNAME=
# OpenPhish community feed (download is switched on in Settings > Network; no key needed)
OPENPHISH_FEED_URL=https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt

# ---------------------------------------------------------------- claim verification (optional)
# Google Fact Check Tools API - https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=

# ---------------------------------------------------------------- optional local AI explanation (Ollama)
# Only used when "AI explanation" is switched on in Settings. The model receives redacted text and the findings list,
# never raw personal data or page content, and it cannot change the verdict.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

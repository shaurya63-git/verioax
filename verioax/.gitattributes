# Binary files: never convert line endings or show text diffs (Windows' autocrlf would corrupt a PDF's byte offsets).
*.pdf    binary
*.png    binary
*.jpg    binary
*.docx   binary
*.woff2  binary
*.sqlite binary

# The evaluation sets are hashed and compared byte for byte (the held-out set is frozen): keep them LF everywhere.
data/eval/*.jsonl text eol=lf
